{
  "name": "bay",
  "version": "0.1.0",
  "description": "bay — a video editor you talk to",
  "type": "module",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Freeholt",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "gen:tools": "node script/gen-tools.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import ./src/test-hooks.mjs --test --test-timeout=30000 \"src/**/*.test.ts\"",
    "bundle": "pnpm build && electron-builder --dir",
    "release": "pnpm build && electron-builder",
    "release:signed": "script/release-signed"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "ffmpeg-ffprobe-static": "^6.1.2-rc.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "electron": "41.10.7",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.2",
    "remark-gfm": "^4.0.1",
    "sucrase": "3.35.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.8"
  }
}
