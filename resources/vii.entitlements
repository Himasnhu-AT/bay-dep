<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What a signed vii is allowed to do. Checked in rather than generated by the bundler: this is
  a security declaration, and one written at build time is invisible in review and can change
  without anyone noticing.

  Every entry is here because something breaks without it:

    allow-jit, allow-unsigned-executable-memory
        GPUI's renderer and the wgpu shader path generate code at runtime. The hardened
        runtime refuses that by default.
    disable-library-validation
        vii loads system frameworks and, through ffmpeg, libraries not signed by us.
    allow-dyld-environment-variables
        the Python speech sidecar is launched with a virtualenv's environment.
    automation.apple-events
        opening the exported file in Finder / QuickTime.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
