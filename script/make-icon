#!/usr/bin/env bash
# Generate assets/vii.icns (macOS) and assets/vii.ico (Windows) from one source image.
#
#   ./script/make-icon                 draw a plain wordmark with ffmpeg, then convert
#   ./script/make-icon path/to/art.png use your own 1024x1024 artwork instead
#
# ffmpeg is already a hard dependency of vii, so generating a placeholder needs nothing extra.
# Replace assets/vii-icon.png with real artwork whenever there is some and re-run.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ASSETS="$ROOT/assets"
SOURCE="${1:-}"
mkdir -p "$ASSETS"

PNG="$ASSETS/vii-icon.png"

if [ -n "$SOURCE" ]; then
  cp "$SOURCE" "$PNG"
  echo "using $SOURCE"
elif [ ! -f "$PNG" ]; then
  echo "drawing a placeholder mark (replace $PNG with real artwork any time)"
  # Pure stdlib Python rather than ffmpeg's drawtext: not every ffmpeg build has freetype, and
  # depending on an image library to draw three rectangles would be a poor trade.
  python3 "$ROOT/script/draw-icon.py" "$PNG"
fi

# ---- macOS .icns -----------------------------------------------------------------
if command -v iconutil >/dev/null 2>&1 && command -v sips >/dev/null 2>&1; then
  SET="$ASSETS/vii.iconset"
  rm -rf "$SET"; mkdir -p "$SET"
  for size in 16 32 128 256 512; do
    sips -z $size $size "$PNG" --out "$SET/icon_${size}x${size}.png" >/dev/null
    double=$((size * 2))
    sips -z $double $double "$PNG" --out "$SET/icon_${size}x${size}@2x.png" >/dev/null
  done
  iconutil -c icns "$SET" -o "$ASSETS/vii.icns"
  rm -rf "$SET"
  echo "wrote $ASSETS/vii.icns"
else
  echo "skipping .icns — iconutil/sips are macOS-only"
fi

# ---- Windows .ico ----------------------------------------------------------------
# ffmpeg cannot write multi-resolution .ico, and ImageMagick is not a dependency worth adding
# just for this. A single 256x256 PNG-in-ICO is valid and is what Windows 10/11 actually use.
if command -v magick >/dev/null 2>&1; then
  magick "$PNG" -define icon:auto-resize=256,128,64,48,32,16 "$ASSETS/vii.ico"
  echo "wrote $ASSETS/vii.ico (multi-resolution)"
elif command -v ffmpeg >/dev/null 2>&1; then
  python3 - "$PNG" "$ASSETS/vii.ico" <<'PY'
import struct, subprocess, sys, tempfile, os

src, dest = sys.argv[1], sys.argv[2]
with tempfile.TemporaryDirectory() as work:
    scaled = os.path.join(work, "256.png")
    subprocess.run(
        ["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", src,
         "-vf", "scale=256:256", scaled],
        check=True)
    png = open(scaled, "rb").read()

# ICONDIR + one ICONDIRENTRY, then the PNG payload. Windows Vista and later accept PNG-in-ICO,
# and a 256x256 entry is recorded as width/height 0 by the format's convention.
header = struct.pack("<HHH", 0, 1, 1)
entry = struct.pack("<BBBBHHII", 0, 0, 0, 0, 1, 32, len(png), 6 + 16)
open(dest, "wb").write(header + entry + png)
print(f"wrote {dest} (256x256 single resolution)")
PY
fi
