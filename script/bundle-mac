#!/usr/bin/env bash
# Build bay.app for macOS, and optionally a signed, notarized .dmg.
#
#   ./script/bundle-mac                 universal .app in dist/macos
#   ./script/bundle-mac --dmg           …and a .dmg next to it
#   ./script/bundle-mac --arch aarch64  this machine's arch only (much faster, for testing)
#
# Signing and notarization are opt-in and need Apple credentials; without them you still get a
# working .app, which macOS will gate behind right-click → Open the first time. Set:
#
#   MACOS_SIGN_IDENTITY        e.g. "Developer ID Application: You (TEAMID)"
#   APPLE_NOTARIZE_PROFILE     a `xcrun notarytool store-credentials` profile name
#
# Shape follows Zed's script/bundle-mac (same GPUI stack): build, assemble Contents/, codesign
# --options runtime, hdiutil for the dmg, notarytool to staple. The difference is that this
# builds a universal binary with lipo rather than one .app per architecture, because bay is one
# small binary and a single download is friendlier than asking which Mac someone has.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

APP_NAME="bay"
BUNDLE_ID="dev.bay.editor"
VERSION="$(grep -m1 '^version' rust/desktop/Cargo.toml | cut -d'"' -f2)"
# Alongside dist/windows, so both platforms' downloads land in one place a person can find.
# dist/ is gitignored; build products do not belong in history.
OUT="$ROOT/dist/macos"
APP="$OUT/$APP_NAME.app"

MAKE_DMG=0
ARCHS=(aarch64-apple-darwin x86_64-apple-darwin)
while [ $# -gt 0 ]; do
  case "$1" in
    --dmg) MAKE_DMG=1 ;;
    --arch)
      shift
      case "$1" in
        aarch64|arm64) ARCHS=(aarch64-apple-darwin) ;;
        x86_64|intel)  ARCHS=(x86_64-apple-darwin) ;;
        *) echo "unknown --arch $1 (aarch64 or x86_64)" >&2; exit 2 ;;
      esac
      ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
  shift
done

echo "── building $APP_NAME $VERSION for ${ARCHS[*]} ──"
for target in "${ARCHS[@]}"; do
  rustup target add "$target" >/dev/null 2>&1 || true
  (cd rust && env -u CARGO_TARGET_DIR cargo build --release --target "$target" -p bay-desktop)
done

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

# One fat binary rather than one .app per arch: bay is a single small executable, and a
# universal download means nobody has to know which Mac they have.
# One executable, not two: `bay --mcp` is the headless server, so there is no separate
# bay-mcp to keep in step. The Kokoro sidecar is compiled into it as well.
if [ ${#ARCHS[@]} -gt 1 ]; then
  echo "── lipo → universal ──"
  lipo -create -output "$APP/Contents/MacOS/bay" \
    "rust/target/aarch64-apple-darwin/release/bay" \
    "rust/target/x86_64-apple-darwin/release/bay"
else
  cp "rust/target/${ARCHS[0]}/release/bay" "$APP/Contents/MacOS/bay"
fi

if [ -f "$ROOT/assets/bay.icns" ]; then
  cp "$ROOT/assets/bay.icns" "$APP/Contents/Resources/bay.icns"
  ICON_ENTRY='<key>CFBundleIconFile</key><string>bay.icns</string>'
else
  echo "  (no assets/bay.icns — run ./script/make-icon to generate one)"
  ICON_ENTRY=''
fi

# The release is also the CLI and the agent skill distribution. Keeping the exact reviewed skill
# inside the app means a consumer does not need a source checkout; the installer links the CLI
# binary and copies this directory into Claude Code, Cursor, and OpenClaw's skill registries.
cp "$ROOT/script/install-agent-tools" "$APP/Contents/Resources/install-agent-tools"
chmod +x "$APP/Contents/Resources/install-agent-tools"
cp -R "$ROOT/.claude/skills/bay" "$APP/Contents/Resources/bay-skill"

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>$APP_NAME</string>
  <key>CFBundleDisplayName</key><string>bay</string>
  <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleExecutable</key><string>bay</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  $ICON_ENTRY
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- bay reads and writes project files and media the user picks. -->
  <key>NSDocumentsFolderUsageDescription</key>
  <string>bay opens and saves your video projects and media.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>bay opens and saves your video projects and media.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>bay opens and saves your video projects and media.</string>
</dict>
</plist>
PLIST

# Entitlements live in resources/, not here: a security declaration generated at build time
# is invisible in review. See that file for why each key is present.
ENTITLEMENTS="$ROOT/resources/bay.entitlements"
[ -f "$ENTITLEMENTS" ] || { echo "missing $ENTITLEMENTS" >&2; exit 1; }
# Checked now rather than at the signing step: codesign rejects a malformed plist with a
# generic error, after the build has already run.
plutil -lint "$ENTITLEMENTS" >/dev/null || { echo "$ENTITLEMENTS is not a valid plist" >&2; exit 1; }

if [ -n "${MACOS_SIGN_IDENTITY:-}" ]; then
  echo "── signing as $MACOS_SIGN_IDENTITY ──"
  # --options runtime is required for notarization; without it the upload is rejected.
  codesign --deep --force --timestamp --options runtime \
    --entitlements "$ENTITLEMENTS" \
    --sign "$MACOS_SIGN_IDENTITY" "$APP" -v
  codesign --verify --deep --strict --verbose=2 "$APP"
else
  # Ad-hoc so the bundle at least has a stable identity; macOS will still gate it on first run.
  codesign --force --deep --sign - "$APP" >/dev/null 2>&1 || true
  echo "  (unsigned — set MACOS_SIGN_IDENTITY to sign; users will need right-click → Open)"
fi

echo "── $APP ──"
du -sh "$APP" | sed 's/^/  /'

if [ "$MAKE_DMG" = "1" ]; then
  DMG="$OUT/$APP_NAME-$VERSION.dmg"
  STAGE="$OUT/dmg"
  rm -rf "$STAGE" "$DMG"
  mkdir -p "$STAGE"
  cp -R "$APP" "$STAGE/"
  ln -s /Applications "$STAGE/Applications"
  hdiutil create -volname "$APP_NAME" -srcfolder "$STAGE" -ov -format UDZO "$DMG" >/dev/null
  rm -rf "$STAGE"
  echo "── $DMG ──"
  du -sh "$DMG" | sed 's/^/  /'

  if [ -n "${APPLE_NOTARIZE_PROFILE:-}" ]; then
    echo "── notarizing (this takes a few minutes) ──"
    xcrun notarytool submit --wait --keychain-profile "$APPLE_NOTARIZE_PROFILE" "$DMG"
    xcrun stapler staple "$DMG"
    echo "  stapled — this .dmg opens without warnings on any Mac"
  else
    echo "  (not notarized — set APPLE_NOTARIZE_PROFILE; Gatekeeper will warn on other Macs)"
  fi
fi

echo
echo "Run it:  open $APP"
if [ "$MAKE_DMG" = "1" ]; then
  echo "Ship it: $DMG  (the .app above is the same build, for running here)"
fi
