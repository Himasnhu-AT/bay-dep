rules_version = '2';

// bay: open access, and the app's usage and crash reports.
//
// Anyone may download bay, and any Google account with a verified address is let
// in, so there is nothing for a browser to write any more: no waitlist, no grant,
// no referral counter. The website's /api/telemetry and /api/crash write the
// report collections with a service account, which these rules do not govern.
// The owner reads them on the website's /admin. See README.md.
//
// Nothing matches outside the collections below, so everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    // A verified email is the only identity these rules trust.
    function verified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return verified() && request.auth.token.email == 'hyattherate2005@gmail.com';
    }

    // ---- reports ------------------------------------------------------------
    // Written only by the website's server credential. The owner reads; no
    // browser writes, the owner's included, so a report on /admin is always one
    // the app sent through the site's checks.

    // One doc per /api/telemetry request, holding its events as an array.
    match /telemetry_batches/{id} {
      allow read: if isOwner();
    }

    // `{day}_{n}`: a day's counters in shards (and `{day}` from before sharding).
    match /telemetry_daily/{id} {
      allow read: if isOwner();
    }

    match /telemetry_installs/{id} {
      allow read: if isOwner();
    }

    match /crashes/{id} {
      allow read: if isOwner();
    }

    // ---- access/{email}: builds released before open access ---------------
    // Those builds read their own grant to decide whether to let the person in.
    // Nothing creates a grant any more; the existing ones stay readable by their
    // owner so an older build keeps working until it updates. Delete this block
    // (and the collection) once no such build is in use.

    match /access/{email} {
      allow get: if isOwner()
        || (verified() && email == request.auth.token.email.lower());
    }
  }
}
