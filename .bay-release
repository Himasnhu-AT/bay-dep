# Release settings for script/release-signed. It is sourced as bash, the way the owner's
# ~/bin/xcnotarize reads ./.xcnotarize, and uses the same variable names.
# Precedence: flags > environment > this file.
#
# Nothing here is a secret. The identity name is printed in every binary it signs. The notary
# credentials live in the login keychain under the profile name. Create them once with
# `xcrun notarytool store-credentials xcnotarize --apple-id … --team-id 38QXSRV6AP`, or run
# `xcnotarize setup`. Never put a password, API key or app-specific password in this file.

# The certificate electron-builder signs with (`security find-identity -v -p codesigning`).
SIGN_ID="Developer ID Application: Himanshu . (38QXSRV6AP)"

# The notarytool keychain profile. `xcrun notarytool history --keychain-profile xcnotarize` must succeed.
NOTARY_PROFILE="xcnotarize"

# arm64 only, for now: pnpm installs only this Mac's claude-agent-sdk-darwin-* package, so an x64
# build made here would ship no `claude`. The script refuses any Mach-O in the bundle that lacks
# the target arch. ffmpeg comes from vendor/ffmpeg/darwin-<arch> (script/build-ffmpeg.sh).
ARCH="arm64"
